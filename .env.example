# SmartBlood AI Environment Configuration
# SIH 2026 Problem Statement: 26202

# Application Settings
PROJECT_NAME="SmartBlood AI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security Secrets (Generate a secure secret key in production)
SECRET_KEY="smartblood-ai-production-grade-jwt-secret-key-sih-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL default, fallback to SQLite for local dev)
DATABASE_URL="postgresql://smartblood_user:smartblood_password@localhost:5432/smartblood_db"
# Local fallback:
# DATABASE_URL="sqlite:///./smartblood.db"

# Data Adapters & Registry Configuration
USE_SYNTHETIC_ERAKTKOSH_DATA=True
ERAKTKOSH_SANDBOX_SEED=42
ALLOW_MOCK_FALLBACKS=True

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# GIS / Mapping Coordinates (Center: Delhi NCR)
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.2090
SEARCH_RADIUS_KM=50.0

# AI Model Configuration
ML_MODEL_DIR="./ml/models"
ENABLE_ANOMALY_ALERTS=True
STALE_INVENTORY_THRESHOLD_HOURS=72
